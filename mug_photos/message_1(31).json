        "link": "https://www.instagram.com/reel/DUnevO2CJel/?id=3830165195251554213_310675859",
        "share_text": "\u00d0\u0098\u00d0\u009f \u00d0\u00bd\u00d0\u00b0 \u00d0\u00a3\u00d0\u00a1\u00d0\u009d: \u00d0\u009d\u00d0\u0094\u00d0\u00a1 \u00d1\u0081\u00d1\u0087\u00d0\u00b8\u00d1\u0082\u00d0\u00b0\u00d1\u008e\u00d1\u0082 \u00d0\u00bd\u00d0\u00b5 \u00d0\u00bf\u00d0\u00be \u00d0\u00bf\u00d1\u0080\u00d0\u00b8\u00d0\u00b1\u00d1\u008b\u00d0\u00bb\u00d0\u00b8, \u00d0\u00b0 \u00d0\u00bf\u00d0\u00be \u00d0\u00b4\u00d0\u00be\u00d1\u0085\u00d0\u00be\u00d0\u00b4\u00d1\u0083\n\n\u00d0\u009a\u00d0\u00be\u00d0\u00bb\u00d0\u00bb\u00d0\u00b5\u00d0\u00b3\u00d0\u00b8, \u00d0\u00b2\u00d0\u00b0\u00d0\u00b6\u00d0\u00bd\u00d1\u008b\u00d0\u00b9 \u00d0\u00bc\u00d0\u00be\u00d0\u00bc\u00d0\u00b5\u00d0\u00bd\u00d1\u0082, \u00d0\u00ba\u00d0\u00be\u00d1\u0082\u00d0\u00be\u00d1\u0080\u00d1\u008b\u00d0\u00b9 \u00d0\u00bc\u00d0\u00bd\u00d0\u00be\u00d0\u00b3\u00d0\u00b8\u00d0\u00b5 \u00d1\u0083\u00d0\u00bf\u00d1\u0083\u00d1\u0081\u00d0\u00ba\u00d0\u00b0\u00d1\u008e\u00d1\u0082.\n\u00d0\u0094\u00d0\u00bb\u00d1\u008f \u00d0\u00be\u00d0\u00bf\u00d1\u0080\u00d0\u00b5\u00d0\u00b4\u00d0\u00b5\u00d0\u00bb\u00d0\u00b5\u00d0\u00bd\u00d0\u00b8\u00d1\u008f \u00d0\u00bf\u00d1\u0080\u00d0\u00b0\u00d0\u00b2\u00d0\u00b0 \u00d0\u00bd\u00d0\u00b0 \u00d0\u00be\u00d1\u0081\u00d0\u00b2\u00d0\u00be\u00d0\u00b1\u00d0\u00be\u00d0\u00b6\u00d0\u00b4\u00d0\u00b5\u00d0\u00bd\u00d0\u00b8\u00d0\u00b5 \u00d0\u00be\u00d1\u0082 \u00d0\u009d\u00d0\u0094\u00d0\u00a1 \u00d1\u0083\u00d1\u0087\u00d0\u00b8\u00d1\u0082\u00d1\u008b\u00d0\u00b2\u00d0\u00b0\u00d1\u008e\u00d1\u0082\u00d1\u0081\u00d1\u008f \u00d1\u0082\u00d0\u00be\u00d0\u00bb\u00d1\u008c\u00d0\u00ba\u00d0\u00be \u00d0\u00b4\u00d0\u00be\u00d1\u0085\u00d0\u00be\u00d0\u00b4\u00d1\u008b, \u00d0\u00b1\u00d0\u00b5\u00d0\u00b7 \u00d1\u0083\u00d1\u0087\u00d0\u00b5\u00d1\u0082\u00d0\u00b0 \u00d1\u0080\u00d0\u00b0\u00d1\u0081\u00d1\u0085\u00d0\u00be\u00d0\u00b4\u00d0\u00be\u00d0\u00b2. \u00d0\u0094\u00d0\u00b0\u00d0\u00b6\u00d0\u00b5 \u00d0\u00b5\u00d1\u0081\u00d0\u00bb\u00d0\u00b8 \u00d0\u00b2\u00d1\u008b \u00d1\u0080\u00d0\u00b0\u00d0\u00b1\u00d0\u00be\u00d1\u0082\u00d0\u00b0\u00d0\u00b5\u00d1\u0082\u00d0\u00b5 \u00d0\u00bd\u00d0\u00b0 \u00d0\u00a3\u00d0\u00a1\u00d0\u009d \u00c2\u00ab\u00d0\u00b4\u00d0\u00be\u00d1\u0085\u00d0\u00be\u00d0\u00b4\u00d1\u008b \u00d0\u00bc\u00d0\u00b8\u00d0\u00bd\u00d1\u0083\u00d1\u0081 \u00d1\u0080\u00d0\u00b0\u00d1\u0081\u00d1\u0085\u00d0\u00be\u00d0\u00b4\u00d1\u008b\u00c2\u00bb.\n\n\u00e2\u009d\u0097\u00ef\u00b8\u008f\u00d0\u00a4\u00d0\u009d\u00d0\u00a1 \u00d0\u00b2 \u00d0\u00bf\u00d0\u00b8\u00d1\u0081\u00d1\u008c\u00d0\u00bc\u00d0\u00b5 \u00d0\u00be\u00d1\u0082 29.10.2025 \u00e2\u0084\u0096 \u00d0\u0097\u00d0\u0093-2-3/16525@ \u00d0\u00bf\u00d1\u0080\u00d1\u008f\u00d0\u00bc\u00d0\u00be \u00d1\u0083\u00d0\u00ba\u00d0\u00b0\u00d0\u00b7\u00d0\u00b0\u00d0\u00bb\u00d0\u00b0: \u00d1\u0080\u00d0\u00b0\u00d1\u0081\u00d1\u0085\u00d0\u00be\u00d0\u00b4\u00d1\u008b \u00d0\u00bf\u00d1\u0080\u00d0\u00b8 \u00d1\u0080\u00d0\u00b0\u00d1\u0081\u00d1\u0087\u00d0\u00b5\u00d1\u0082\u00d0\u00b5 \u00d0\u009d\u00d0\u0094\u00d0\u00a1-\u00d0\u00bb\u00d0\u00b8\u00d0\u00bc\u00d0\u00b8\u00d1\u0082\u00d0\u00b0 \u00d0\u00b7\u00d0\u00bd\u00d0\u00b0\u00d1\u0087\u00d0\u00b5\u00d0\u00bd\u00d0\u00b8\u00d1\u008f \u00d0\u00bd\u00d0\u00b5 \u00d0\u00b8\u00d0\u00bc\u00d0\u00b5\u00d1\u008e\u00d1\u0082.\n\n\u00d0\u00a0\u00d0\u00b0\u00d0\u00b7\u00d0\u00b1\u00d0\u00b5\u00d1\u0080\u00d0\u00b5\u00d0\u00bc \u00d0\u00bd\u00d0\u00b0 \u00d0\u00ba\u00d0\u00be\u00d0\u00bd\u00d0\u00ba\u00d1\u0080\u00d0\u00b5\u00d1\u0082\u00d0\u00bd\u00d1\u008b\u00d1\u0085 \u00d1\u0086\u00d0\u00b8\u00d1\u0084\u00d1\u0080\u00d0\u00b0\u00d1\u0085:\n\u00e2\u0080\u00a2 \u00d0\u0094\u00d0\u00be\u00d1\u0085\u00d0\u00be\u00d0\u00b4 \u00d0\u00b7\u00d0\u00b0 2025 \u00d0\u00b3\u00d0\u00be\u00d0\u00b4 \u00e2\u0080\u0094 25 \u00d0\u00bc\u00d0\u00bb\u00d0\u00bd \u00e2\u0082\u00bd\n\u00e2\u0080\u00a2 \u00d0\u00a0\u00d0\u00b0\u00d1\u0081\u00d1\u0085\u00d0\u00be\u00d0\u00b4\u00d1\u008b \u00e2\u0080\u0094 19 \u00d0\u00bc\u00d0\u00bb\u00d0\u00bd \u00e2\u0082\u00bd\n\u00e2\u0080\u00a2 \u00d0\u009f\u00d0\u00be \u00d0\u00a3\u00d0\u00a1\u00d0\u009d \u00d0\u00b1\u00d0\u00b0\u00d0\u00b7\u00d0\u00b0 \u00d1\u0081\u00d0\u00be\u00d1\u0081\u00d1\u0082\u00d0\u00b0\u00d0\u00b2\u00d0\u00b8\u00d1\u0082 6 \u00d0\u00bc\u00d0\u00bb\u00d0\u00bd \u00e2\u0082\u00bd\n\n \u00e2\u0080\u00bc\u00ef\u00b8\u008f\u00d0\u009d\u00d0\u00be \u00d0\u00b4\u00d0\u00bb\u00d1\u008f \u00d0\u009d\u00d0\u0094\u00d0\u00a1 \u00d0\u00bb\u00d0\u00b8\u00d0\u00bc\u00d0\u00b8\u00d1\u0082 \u00d1\u0081\u00d1\u0087\u00d0\u00b8\u00d1\u0082\u00d0\u00b0\u00d0\u00b5\u00d1\u0082\u00d1\u0081\u00d1\u008f \u00d0\u00b8\u00d0\u00bd\u00d0\u00b0\u00d1\u0087\u00d0\u00b5 \u00e2\u0080\u0094 \u00d0\u00b1\u00d0\u00b5\u00d1\u0080\u00d0\u00b5\u00d1\u0082\u00d1\u0081\u00d1\u008f \u00d0\u00b2\u00d0\u00b5\u00d1\u0081\u00d1\u008c \u00d0\u00b4\u00d0\u00be\u00d1\u0085\u00d0\u00be\u00d0\u00b4, \u00d1\u0082\u00d0\u00be \u00d0\u00b5\u00d1\u0081\u00d1\u0082\u00d1\u008c 25 \u00d0\u00bc\u00d0\u00bb\u00d0\u00bd, \u00d1\u0087\u00d1\u0082\u00d0\u00be \u00d0\u00b2\u00d1\u008b\u00d1\u0088\u00d0\u00b5 \u00d1\u0083\u00d1\u0081\u00d1\u0082\u00d0\u00b0\u00d0\u00bd\u00d0\u00be\u00d0\u00b2\u00d0\u00bb\u00d0\u00b5\u00d0\u00bd\u00d0\u00bd\u00d0\u00be\u00d0\u00b3\u00d0\u00be \u00d0\u00bf\u00d0\u00be\u00d1\u0080\u00d0\u00be\u00d0\u00b3\u00d0\u00b0 \u00d0\u00b2 20 \u00d0\u00bc\u00d0\u00bb\u00d0\u00bd. \u00d0\u00a1\u00d0\u00bb\u00d0\u00b5\u00d0\u00b4\u00d0\u00be\u00d0\u00b2\u00d0\u00b0\u00d1\u0082\u00d0\u00b5\u00d0\u00bb\u00d1\u008c\u00d0\u00bd\u00d0\u00be, \u00d1\u0081 2026 \u00d0\u00b3\u00d0\u00be\u00d0\u00b4\u00d0\u00b0 \u00d0\u00b2\u00d0\u00be\u00d0\u00b7\u00d0\u00bd\u00d0\u00b8\u00d0\u00ba\u00d0\u00b0\u00d0\u00b5\u00d1\u0082 \u00d0\u00be\u00d0\u00b1\u00d1\u008f\u00d0\u00b7\u00d0\u00b0\u00d0\u00bd\u00d0\u00bd\u00d0\u00be\u00d1\u0081\u00d1\u0082\u00d1\u008c \u00d0\u00bf\u00d0\u00bb\u00d0\u00b0\u00d1\u0082\u00d0\u00b8\u00d1\u0082\u00d1\u008c \u00d0\u009d\u00d0\u0094\u00d0\u00a1.\n\n\u00d0\u0098 \u00d0\u00b7\u00d0\u00b4\u00d0\u00b5\u00d1\u0081\u00d1\u008c \u00d0\u00b2\u00d0\u00b0\u00d0\u00b6\u00d0\u00bd\u00d0\u00be \u00d0\u00bf\u00d0\u00be\u00d0\u00bd\u00d0\u00b8\u00d0\u00bc\u00d0\u00b0\u00d1\u0082\u00d1\u008c: \u00d0\u00bd\u00d0\u00b0\u00d0\u00bb\u00d0\u00be\u00d0\u00b3\u00d0\u00be\u00d0\u00b2\u00d0\u00b0\u00d1\u008f \u00d1\u0081\u00d0\u00bc\u00d0\u00be\u00d1\u0082\u00d1\u0080\u00d0\u00b8\u00d1\u0082 \u00d0\u00bd\u00d0\u00b0 \u00d1\u0084\u00d0\u00b0\u00d0\u00ba\u00d1\u0082\u00d0\u00b8\u00d1\u0087\u00d0\u00b5\u00d1\u0081\u00d0\u00ba\u00d0\u00b8\u00d0\u00b5 \u00d0\u00b4\u00d0\u00be\u00d1\u0085\u00d0\u00be\u00d0\u00b4\u00d1\u008b, \u00d0\u00b0 \u00d0\u00bd\u00d0\u00b5 \u00d0\u00bd\u00d0\u00b0 \u00d1\u0082\u00d0\u00be, \u00d0\u00ba\u00d0\u00b0\u00d0\u00ba \u00d0\u00b2\u00d0\u00b0\u00d0\u00bc \u00c2\u00ab\u00d1\u0083\u00d0\u00b4\u00d0\u00be\u00d0\u00b1\u00d0\u00bd\u00d0\u00be\u00c2\u00bb \u00d0\u00b8\u00d1\u0085 \u00d0\u00be\u00d1\u0082\u00d1\u0080\u00d0\u00b0\u00d0\u00b7\u00d0\u00b8\u00d1\u0082\u00d1\u008c.\n\n\u00d0\u009f\u00d0\u00be\u00d0\u00bf\u00d1\u008b\u00d1\u0082\u00d0\u00ba\u00d0\u00b0 \u00d0\u00b7\u00d0\u00b0\u00d0\u00b4\u00d0\u00bd\u00d0\u00b8\u00d0\u00bc \u00d1\u0087\u00d0\u00b8\u00d1\u0081\u00d0\u00bb\u00d0\u00be\u00d0\u00bc \u00d0\u00ba\u00d0\u00be\u00d1\u0080\u00d1\u0080\u00d0\u00b5\u00d0\u00ba\u00d1\u0082\u00d0\u00b8\u00d1\u0080\u00d0\u00be\u00d0\u00b2\u00d0\u00b0\u00d1\u0082\u00d1\u008c \u00d0\u00b2\u00d1\u008b\u00d1\u0080\u00d1\u0083\u00d1\u0087\u00d0\u00ba\u00d1\u0083 \u00d0\u00b8\u00d0\u00bb\u00d0\u00b8 \u00d0\u00bf\u00d0\u00b5\u00d1\u0080\u00d0\u00b5\u00d0\u00bd\u00d0\u00be\u00d1\u0081\u00d0\u00b8\u00d1\u0082\u00d1\u008c \u00d0\u00b4\u00d0\u00be\u00d0\u00ba\u00d1\u0083\u00d0\u00bc\u00d0\u00b5\u00d0\u00bd\u00d1\u0082\u00d1\u008b \u00e2\u0080\u0094 \u00d0\u00bd\u00d0\u00b5 \u00d1\u0081\u00d1\u0082\u00d1\u0080\u00d0\u00b0\u00d1\u0082\u00d0\u00b5\u00d0\u00b3\u00d0\u00b8\u00d1\u008f, \u00d0\u00b0 \u00d0\u00bf\u00d1\u0083\u00d1\u0082\u00d1\u008c \u00d0\u00ba \u00d0\u00b4\u00d0\u00be\u00d0\u00bd\u00d0\u00b0\u00d1\u0087\u00d0\u00b8\u00d1\u0081\u00d0\u00bb\u00d0\u00b5\u00d0\u00bd\u00d0\u00b8\u00d1\u008f\u00d0\u00bc \u00d0\u00b8 \u00d0\u00b2\u00d0\u00be\u00d0\u00bf\u00d1\u0080\u00d0\u00be\u00d1\u0081\u00d0\u00b0\u00d0\u00bc \u00d1\u0081\u00d0\u00be \u00d1\u0081\u00d1\u0082\u00d0\u00be\u00d1\u0080\u00d0\u00be\u00d0\u00bd\u00d1\u008b \u00d0\u00b8\u00d0\u00bd\u00d1\u0081\u00d0\u00bf\u00d0\u00b5\u00d0\u00ba\u00d1\u0086\u00d0\u00b8\u00d0\u00b8.\n\u00d0\u0098\u00d1\u0081\u00d0\u00bf\u00d1\u0080\u00d0\u00b0\u00d0\u00b2\u00d0\u00bb\u00d1\u008f\u00d1\u0082\u00d1\u008c \u00d0\u00bd\u00d1\u0083\u00d0\u00b6\u00d0\u00bd\u00d0\u00be \u00d0\u00be\u00d1\u0088\u00d0\u00b8\u00d0\u00b1\u00d0\u00ba\u00d0\u00b8, \u00d0\u00b0 \u00d0\u00bd\u00d0\u00b5 \u00d0\u00b8\u00d1\u0081\u00d1\u0082\u00d0\u00be\u00d1\u0080\u00d0\u00b8\u00d1\u008e.\n\n\u00d0\u009f\u00d0\u00be\u00d1\u008d\u00d1\u0082\u00d0\u00be\u00d0\u00bc\u00d1\u0083 \u00d0\u00b5\u00d1\u0081\u00d0\u00bb\u00d0\u00b8 \u00d0\u00b2\u00d0\u00b0\u00d1\u0088 \u00d0\u00b4\u00d0\u00be\u00d1\u0085\u00d0\u00be\u00d0\u00b4 \u00d0\u00bf\u00d1\u0080\u00d0\u00b8\u00d0\u00b1\u00d0\u00bb\u00d0\u00b8\u00d0\u00b6\u00d0\u00b0\u00d0\u00b5\u00d1\u0082\u00d1\u0081\u00d1\u008f \u00d0\u00ba \u00d0\u00bb\u00d0\u00b8\u00d0\u00bc\u00d0\u00b8\u00d1\u0082\u00d1\u0083 \u00e2\u0080\u0094 \u00d1\u0080\u00d0\u00b5\u00d1\u0088\u00d0\u00b5\u00d0\u00bd\u00d0\u00b8\u00d0\u00b5 \u00d0\u00bd\u00d1\u0083\u00d0\u00b6\u00d0\u00bd\u00d0\u00be \u00d0\u00bf\u00d1\u0080\u00d0\u00b8\u00d0\u00bd\u00d0\u00b8\u00d0\u00bc\u00d0\u00b0\u00d1\u0082\u00d1\u008c \u00d0\u00b7\u00d0\u00b0\u00d1\u0080\u00d0\u00b0\u00d0\u00bd\u00d0\u00b5\u00d0\u00b5: \u00d0\u00bf\u00d1\u0080\u00d0\u00be\u00d1\u0081\u00d1\u0087\u00d0\u00b8\u00d1\u0082\u00d1\u008b\u00d0\u00b2\u00d0\u00b0\u00d1\u0082\u00d1\u008c \u00d0\u00bd\u00d0\u00b0\u00d0\u00bb\u00d0\u00be\u00d0\u00b3\u00d0\u00be\u00d0\u00b2\u00d1\u00